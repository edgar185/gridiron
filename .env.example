POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://gridiron:change_me@localhost:5432/gridironiq
ODDS_API_KEY=your_key_from_the-odds-api.com
# Only needed for private ESPN leagues (public leagues can leave these unset).
# Grab from a logged-in fantasy.espn.com session: DevTools -> Application -> Cookies.
# These expire periodically -- re-copy them if espn_ingest.py starts 401ing.
ESPN_S2=
ESPN_SWID={your-swid-cookie-including-braces}
# Powers the in-app "ask a model" feature (/v1/ask) -- get one from
# console.anthropic.com. Real usage-based cost per question.
ANTHROPIC_API_KEY=
